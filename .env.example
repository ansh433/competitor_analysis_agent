# Required runtime settings (placeholders only)
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db:5432/competitor_intelligence
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
TAVILY_API_KEY=replace-with-tavily-api-key
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Runtime selection: use deterministic only for local demos and tests
PROVIDER_MODE=live
ENVIRONMENT=local

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true

# Optional error monitoring
SENTRY_DSN=

# Docker Compose database placeholders (choose non-default values)
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_DB=replace-with-database-name

# Optional quota overrides
STANDARD_RESEARCH_RUNS_PER_DAY=5
UPGRADED_RESEARCH_RUNS_PER_DAY=2
MAXIMUM_SOURCES_PER_RUN=30
MAXIMUM_GAP_RESEARCH_LOOPS=2
SUPERUSER_QUOTA_BYPASS=true

